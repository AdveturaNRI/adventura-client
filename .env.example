EXPO_PUBLIC_API_URL=https://adventura-api-production.up.railway.app/api
# Yandex Metrika: prefer Admin → «Яндекс Метрика». Env is fallback only.
# EXPO_PUBLIC_YANDEX_METRIKA_ID=

# OAuth (web). VK ID accepts only https redirects — for local use a tunnel:
#   npx cloudflared tunnel --url http://localhost:8081
# Then open the app via the https://….trycloudflare.com URL and put that
# origin in VK Trusted Redirect URL (and Yandex Suggest Hostname / Callback).
# EXPO_PUBLIC_VK_APP_ID=
# EXPO_PUBLIC_YANDEX_CLIENT_ID=

# Firebase Cloud Messaging (web)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Web Push certificates key (Firebase Console → Project settings → Cloud Messaging)
# Fallback if API FIREBASE_WEB_VAPID_KEY is empty. Public key — ok in client bundle.
EXPO_PUBLIC_FIREBASE_VAPID_KEY=
