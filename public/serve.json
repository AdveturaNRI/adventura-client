{
  "cleanUrls": false,
  "directoryListing": false,
  "headers": [
    {
      "source": "**/*.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/firebase-config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/_expo/static/**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/vendor/**",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/dice-box/**",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/icons/**",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ],
  "rewrites": [
    { "source": "/l/:slug", "destination": "/l/[slug].html" },
    { "source": "/games/:id", "destination": "/games/[id].html" },
    { "source": "/users/:id", "destination": "/users/[id].html" },
    { "source": "/chats/:id", "destination": "/chats/[id].html" },
    { "source": "/clubs/:id", "destination": "/clubs/[id].html" },
    { "source": "/authors/:authorId/posts/:postId", "destination": "/authors/[authorId]/posts/[postId].html" },
    { "source": "/authors/:authorId", "destination": "/authors/[authorId].html" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/games", "destination": "/games.html" },
    { "source": "/wanderers", "destination": "/wanderers.html" },
    { "source": "/clubs", "destination": "/clubs.html" },
    { "source": "/dice", "destination": "/dice.html" },
    { "source": "/chats", "destination": "/chats/index.html" },
    { "source": "/news", "destination": "/news/index.html" },
    { "source": "/news/:id", "destination": "/news/[id].html" },
    { "source": "/handbook", "destination": "/handbook/index.html" },
    { "source": "/handbook/:systemId", "destination": "/handbook/[systemId].html" },
    { "source": "/music-library", "destination": "/music-library.html" },
    { "source": "/authors", "destination": "/authors/index.html" },
    { "source": "/author-cabinet", "destination": "/author-cabinet.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/notifications", "destination": "/notifications.html" },
    { "source": "/settings", "destination": "/settings.html" },
    { "source": "/questionnaire", "destination": "/questionnaire.html" },
    { "source": "/master-room", "destination": "/master-room.html" },
    { "source": "/my-clubs", "destination": "/my-clubs.html" },
    { "source": "/clubs-create", "destination": "/clubs-create.html" },
    { "source": "/my-games", "destination": "/my-games.html" },
    { "source": "/games-create", "destination": "/games-create.html" },
    { "source": "/games-edit", "destination": "/games-edit.html" },
    { "source": "/games-manage", "destination": "/games-manage.html" },
    { "source": "/auth/login", "destination": "/auth/login.html" },
    { "source": "/auth/register", "destination": "/auth/register.html" },
    { "source": "/auth/forgot-password", "destination": "/auth/forgot-password.html" },
    { "source": "/auth/reset-password", "destination": "/auth/reset-password.html" },
    { "source": "/auth/verify-email", "destination": "/auth/verify-email.html" },
    { "source": "/auth/oauth/yandex/callback", "destination": "/auth/oauth/yandex/callback.html" },
    { "source": "/generators", "destination": "/generators.html" },
    { "source": "/characters", "destination": "/characters.html" },
    { "source": "/rewards-lab", "destination": "/rewards-lab.html" },
    { "source": "/profile-appearance", "destination": "/profile-appearance.html" },
    { "source": "/clubs-edit", "destination": "/clubs-edit.html" },
    { "source": "/ui-lib/components", "destination": "/ui-lib/components.html" },
    { "source": "/ui-lib/rewards", "destination": "/ui-lib/rewards.html" }
  ]
}
